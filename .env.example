# Server Environment Configuration
PORT=3000
NODE_ENV=development

# Security & Session Secrets (Generate strong random secrets for production, e.g. using `openssl rand -hex 32`)
SESSION_SECRET=replace_with_a_secure_random_string_at_least_32_chars
CSRF_SECRET=replace_with_a_secure_csrf_secret_string

# Database & File Storage
DB_PATH=./data/sales_platform.db
UPLOAD_DIR=./uploads/payment_proofs

# Commercial Configuration
UPI_ID=varunchauhan1998@ybl
UPI_PAYEE_NAME=API Section
PRODUCT_PRICE_INR=3499
PRODUCT_NAME=Rich Text Editor API
SUPPORT_EMAIL=support@apisection.com

# Email / SMTP Invoice Dispatch Configuration
# Set these on Vercel or your production server to send real emails to customers
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="API Section Billing <billing@apisection.com>"

